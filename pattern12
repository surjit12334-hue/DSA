class Solution {
public:
    void pattern12(int n) {
        for(int i=0;i<n;i++)
        {
            //digits
            for(int j=1;j<=i+1;j++)
            {
                cout << j;
            }
            //space
            for(int j=0;j<2*(n-i-1);j++)
            {
                cout << " ";
            }
            //digits
            for(int j=i+1;j>=1;j--)
            {
                cout << j;
            }
            cout <<  endl;

        }

    }
};
